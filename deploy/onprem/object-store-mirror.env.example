# Copy to /etc/ieum/object-store-mirror.env, replace the angle-bracket values,
# then set owner root:root and mode 0600. This is a one-time migration-only
# credential file; it is not loaded by app-main or app-ai.
# Reuse the existing ieum-files bucket and the already-created ieum-app-main
# MinIO service-account credentials; do not create a separate migration user.
# mc is executed inside the existing vlainter-minio container; no image is pulled.
MIRROR_SOURCE_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
MIRROR_SOURCE_ACCESS_KEY=<aws-s3-migration-access-key>
MIRROR_SOURCE_SECRET_KEY=<aws-s3-migration-secret-key>
MIRROR_SOURCE_BUCKET=ieum-prod-files
MIRROR_TARGET_ENDPOINT=http://minio:9000
MIRROR_TARGET_ACCESS_KEY=<existing-ieum-app-main-access-key>
MIRROR_TARGET_SECRET_KEY=<existing-ieum-app-main-secret-key>
MIRROR_TARGET_BUCKET=ieum-files
