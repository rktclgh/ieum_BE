# On-premises runtime file: install as /etc/ieum/app-ai.env (root:root, mode 0600).
# Never commit real credentials or copy this file into GitHub Actions.
#
# Production runs the AI job transport on RabbitMQ in both directions: app-ai
# consumes dispatch jobs from the broker (APP_AI_DISPATCH_TRANSPORT=rabbitmq)
# and publishes completion callbacks to it (APP_AI_QUESTION_CALLBACK_TRANSPORT=
# rabbitmq, APP_AI_COMPLETION_RELAY_ENABLED=true) — see the block at the
# bottom. ieum-validate-runtime-env always requires a valid
# APP_AI_DISPATCH_TRANSPORT (http|rabbitmq). It requires
# RABBITMQ_HOST/PORT/VIRTUAL_HOST/USERNAME/PASSWORD, and ieum-bootstrap-control-plane
# refuses to run unless the RabbitMQ broker is up and reachable, whenever this
# service will dial the broker: APP_AI_DISPATCH_TRANSPORT=rabbitmq, or
# APP_AI_QUESTION_CALLBACK_TRANSPORT=rabbitmq, or
# APP_AI_COMPLETION_RELAY_ENABLED=true. The broker is provisioned by
# ieum-provision-rabbitmq. The only configuration that needs no RABBITMQ_* keys
# is a full rollback to http with all three of those switched off.

SERVER_PORT=8081

SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/ieum
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

AWS_REGION=ap-northeast-2
# Reuse the existing server-held Bedrock credential for cutover.
# Do not create a new IAM identity, instance profile, container, or credential service;
# an Ieum-only least-privilege identity is post-cutover hardening.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
APP_AI_BEDROCK_PROFILE=
SPRING_AI_MODEL_CHAT=bedrock-converse

APP_AI_FEATURES_REPORT_REVIEW_ENABLED=true
APP_AI_FEATURES_QUESTION_ANSWER_ENABLED=true
APP_AI_FEATURES_ACCEPTED_ANSWER_INGESTION_ENABLED=true
APP_AI_FEATURES_ACCEPTED_ANSWER_RELATION_CANDIDATES_ENABLED=false
APP_AI_FEATURES_WEB_GROUNDING_ENABLED=false
APP_AI_FEATURES_UNGROUNDED_ANSWER_ENABLED=false

# One shared Gemini API key for report review, embeddings, local answers, and web grounding.
APP_AI_GEMINI_API_KEY=

# Exact hostname from app-main's AWS_S3_PRESIGN_ENDPOINT (without scheme or path).
APP_AI_REPORT_IMAGE_ALLOWED_HOSTS=files.rktclgh.site
APP_AI_REPORT_IMAGE_MAX_BYTES=3750000
APP_AI_REPORT_IMAGE_MAX_TOTAL_BYTES=15000000
APP_AI_REPORT_IMAGE_DOWNLOAD_TIMEOUT=5s
APP_AI_REPORT_GEMINI_MODEL=gemini-3.1-flash-lite
APP_AI_REPORT_NOVA_MODEL=apac.amazon.nova-lite-v1:0
APP_AI_REPORT_PROMPT_VERSION=report-review-v1

APP_AI_QUESTION_EMBEDDING_MODEL_TIMEOUT=10s
APP_AI_QUESTION_EMBEDDING_TOTAL_ATTEMPTS=1
APP_AI_QUESTION_ANSWER_TASK_LEASE=2m
APP_AI_QUESTION_ANSWER_MAX_ATTEMPTS=5
APP_AI_QUESTION_ANSWER_RECOVERY_INTERVAL=60s
APP_AI_QUESTION_ANSWER_RECOVERY_BATCH_SIZE=32
APP_AI_QUESTION_ANSWER_DISPATCH_RETRY_AFTER_SECONDS=5
APP_AI_KNOWLEDGE_RELATION_RECOVERY_INTERVAL=30s
APP_AI_KNOWLEDGE_RELATION_RECOVERY_BATCH_SIZE=8
APP_AI_QUESTION_ANALYZER_MODEL=apac.amazon.nova-micro-v1:0
APP_AI_QUESTION_ANALYZER_ANALYSIS_VERSION=question-query-analysis-v1
APP_AI_QUESTION_ANALYZER_MAX_TOKENS=512
APP_AI_BEDROCK_REGION=ap-northeast-2
APP_AI_BEDROCK_TIMEOUT=30s

APP_AI_QUESTION_GENERATION_NOVA_MODEL=apac.amazon.nova-micro-v1:0
APP_AI_QUESTION_GENERATION_GEMINI_MODEL=gemini-3.1-flash-lite
APP_AI_QUESTION_GENERATION_PROMPT_VERSION=question-local-answer-v1
APP_AI_QUESTION_GENERATION_MAX_TOKENS=1024
APP_AI_QUESTION_GENERATION_MODEL_TIMEOUT=30s

APP_AI_QUESTION_UNGROUNDED_MODEL=gemini-3.1-flash-lite
APP_AI_QUESTION_UNGROUNDED_PROMPT_VERSION=question-ungrounded-answer-v1
APP_AI_QUESTION_UNGROUNDED_MAX_TOKENS=1024
APP_AI_QUESTION_UNGROUNDED_MODEL_TIMEOUT=30s

APP_AI_QUESTION_GROUNDING_VALIDATION_PROMPT_VERSION=question-grounding-validation-v1
APP_AI_QUESTION_GROUNDING_REPAIR_PROMPT_VERSION=question-grounding-repair-v1
APP_AI_QUESTION_GROUNDING_VALIDATION_MAX_TOKENS=512
APP_AI_QUESTION_GROUNDING_REPAIR_MAX_TOKENS=1024
APP_AI_QUESTION_GROUNDING_MODEL_TIMEOUT=30s

APP_AI_QUESTION_CALLBACK_BASE_ORIGIN=http://app-main:8080
APP_AI_QUESTION_CALLBACK_ALLOWED_ORIGINS=http://app-main:8080
APP_AI_QUESTION_CALLBACK_CONNECT_TIMEOUT=2s
APP_AI_QUESTION_CALLBACK_READ_TIMEOUT=5s
APP_AI_QUESTION_CALLBACK_RECOVERY_INTERVAL=60s
APP_AI_QUESTION_CALLBACK_RECOVERY_BATCH_SIZE=32

# Use exactly the same random value in app-main.
APP_AI_INTERNAL_CALLBACK_TOKEN=

# --- RabbitMQ AI job transport (docs/rabbitmq-dispatch/spec.md §11.4/§11.5) ---
# As built:
#   APP_AI_DISPATCH_TRANSPORT=rabbitmq — app-ai consumes dispatch jobs from the
#            broker. This is the only supported value for a normal deploy; the
#            broker consumer declares the queue topology on startup.
#   APP_AI_QUESTION_CALLBACK_TRANSPORT=rabbitmq — completion notices are
#            published to the broker and drained by app-main's result
#            consumer (APP_AI_RESULT_CONSUMER_ENABLED=true in app-main.env).
#            `http` is a rollback mode only: it selects the @Deprecated HTTP
#            callback client (removal tracked in issue #254) and then requires
#            the APP_AI_QUESTION_CALLBACK_BASE_ORIGIN/ALLOWED_ORIGINS/
#            INTERNAL_CALLBACK_TOKEN values above to be filled in.
#   APP_AI_COMPLETION_RELAY_ENABLED=true — broker-only safety net that
#            re-publishes completion notices whose broker confirm was lost.
#            Constraint: the relay bean exists only when ALL of
#            APP_AI_FEATURES_QUESTION_ANSWER_ENABLED=true (set above — the
#            relay's QuestionCompletionCallbackClient dependency only exists
#            then), APP_AI_QUESTION_CALLBACK_TRANSPORT=rabbitmq (under http it
#            would become a duplicate HTTP re-poller), and this flag are true.
#            If any one is off the bean is simply absent — not a startup
#            failure. Set it to false during an http rollback as well: a true
#            value still makes the validator/bootstrap require RABBITMQ_*.
APP_AI_DISPATCH_TRANSPORT=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VIRTUAL_HOST=/ieum
RABBITMQ_USERNAME=ieum_ai
RABBITMQ_PASSWORD=
APP_AI_QUESTION_CALLBACK_TRANSPORT=rabbitmq
APP_AI_COMPLETION_RELAY_ENABLED=true
