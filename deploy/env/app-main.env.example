# On-premises runtime file: install as /etc/ieum/app-main.env (root:root, mode 0600).
# Never commit real credentials or copy this file into GitHub Actions.

SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=native

SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/ieum
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
INQUIRY_ADMIN_EMAIL=

JWT_SECRET=
EMAIL_VERIFICATION_HMAC_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=https://ieum.rktclgh.site,https://ieum1.rktclgh.site

WEB_PUSH_ENABLED=true
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com
WEB_PUSH_CONNECT_TIMEOUT=2s
WEB_PUSH_REQUEST_TIMEOUT=5s
WEB_PUSH_EXECUTOR_THREADS=2
WEB_PUSH_EXECUTOR_QUEUE=128
WEB_PUSH_EXECUTOR_SHUTDOWN_SECONDS=10

GOOGLE_CLIENT_ID=
GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URIS=https://ieum.rktclgh.site/oauth/kakao/callback/
KAKAO_TOKEN_URI=https://kauth.kakao.com/oauth/token
KAKAO_JWK_SET_URI=https://kauth.kakao.com/.well-known/jwks.json

NAVER_SEARCH_BASE_URL=https://openapi.naver.com
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NCP_MAPS_BASE_URL=https://maps.apigw.ntruss.com
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=
PLACE_CONNECT_TIMEOUT_MS=2000
PLACE_READ_TIMEOUT_MS=3000
PLACE_MAX_CONCURRENT=20

GOOGLE_TRANSLATE_API_KEY=

# Bedrock remains in Seoul. MinIO signing is set independently below.
AWS_REGION=ap-northeast-2
# Required whenever AWS_S3_ENDPOINT is set. Current MinIO has no configured region.
AWS_S3_REGION=us-east-1
# Reuse the existing ieum-app-main MinIO service-account credentials; do not create a new MinIO user.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN is intentionally unsupported by the on-prem release contract.
AWS_S3_BUCKET=ieum-files
# Internal Docker DNS endpoint for app-main; public HTTPS endpoint for presigned browser/app-ai URLs.
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_PRESIGN_ENDPOINT=https://files.rktclgh.site
AWS_S3_PATH_STYLE_ACCESS_ENABLED=true
AWS_S3_API_CALL_TIMEOUT_SECONDS=10
AWS_S3_API_CALL_ATTEMPT_TIMEOUT_SECONDS=3
APP_FILE_S3_TMP_PREFIX=tmp
APP_FILE_S3_FINAL_PREFIX=final
APP_FILE_PRESIGN_TTL_MINUTES=15
APP_FILE_MAX_SIZE_BYTES=10485760
APP_FILE_MAX_SOURCE_PIXELS=50000000
APP_FILE_MAX_SOURCE_DIMENSION=16384
APP_FILE_DISPLAY_MAX_PX=1280
APP_FILE_THUMB_MAX_PX=320
APP_FILE_WEBP_QUALITY=80

APP_AI_REPORT_ENABLED=true
APP_AI_REPORT_BASE_URL=http://app-ai:8081
APP_AI_REPORT_ALLOWED_HOSTS=app-ai
APP_AI_REPORT_CONNECT_TIMEOUT_SECONDS=2
APP_AI_REPORT_READ_TIMEOUT_SECONDS=90

APP_AI_QUESTION_ANSWER_DISPATCH_ENABLED=true
APP_AI_QUESTION_ANSWER_DISPATCH_BASE_URL=http://app-ai:8081
APP_AI_QUESTION_ANSWER_DISPATCH_ALLOWED_HOSTS=app-ai
APP_AI_QUESTION_ANSWER_DISPATCH_CONNECT_TIMEOUT_SECONDS=2
APP_AI_QUESTION_ANSWER_DISPATCH_READ_TIMEOUT_SECONDS=5

APP_AI_ACCEPTED_ANSWER_DISPATCH_ENABLED=true
APP_AI_ACCEPTED_ANSWER_DISPATCH_BASE_URL=http://app-ai:8081
APP_AI_ACCEPTED_ANSWER_DISPATCH_ALLOWED_HOSTS=app-ai
APP_AI_ACCEPTED_ANSWER_DISPATCH_CONNECT_TIMEOUT_SECONDS=2
APP_AI_ACCEPTED_ANSWER_DISPATCH_READ_TIMEOUT_SECONDS=5

# Use exactly the same random value in app-ai.
APP_AI_INTERNAL_CALLBACK_TOKEN=
